# 复制为 .env 后按实际环境修改。未设置时使用代码内默认值。

# 桥接模式：mock=模拟开发板（默认，无需硬件）；serial=真实 COM 串口
SMART_ACCESS_BRIDGE_MODE=mock

# board：板载摄像头特征授权；legacy：旧浏览器摄像头演示。
SMART_ACCESS_INPUT=board

# 真实串口参数（serial 模式使用）
SMART_ACCESS_SERIAL_PORT=COM10
SMART_ACCESS_SERIAL_BAUD=115200
# 每个命令字符之间等待的秒数；0 恢复原整行发送，便于故障对照。
SMART_ACCESS_SERIAL_CHAR_INTERVAL=0.003

# 新板端演示使用独立目录，避免读写原照片演示数据库。
# 不设置时使用项目根目录下的 data/；也可填写本机绝对路径。
# SMART_ACCESS_DATA=C:\your-project\demo-data

# API 服务
SMART_ACCESS_HOST=127.0.0.1
SMART_ACCESS_PORT=8000

# 人脸识别全局默认阈值（LBPH 距离，越小越相似）。每个人员可用校准值覆盖
SMART_ACCESS_DEFAULT_THRESHOLD=80

# 心跳与离线判定（秒）
SMART_ACCESS_HEARTBEAT_INTERVAL=5
SMART_ACCESS_OFFLINE_AFTER=15
SMART_ACCESS_CMD_TIMEOUT=2
